# Copy to .env and customize before public deployment

# App
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/service_marketplace_platform
SPRING_DATASOURCE_USERNAME=marketplace_app
SPRING_DATASOURCE_PASSWORD=change_me_strong_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
APP_UPLOAD_DIR=/app/uploads/

# MySQL container bootstrap
MYSQL_DATABASE=service_marketplace_platform
MYSQL_USER=marketplace_app
MYSQL_PASSWORD=change_me_strong_password
MYSQL_ROOT_PASSWORD=change_me_root_password
